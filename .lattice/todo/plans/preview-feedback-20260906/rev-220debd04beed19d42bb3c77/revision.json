{"desired_plan":{"hard_dependencies":[{"from":{"plan_key":"preview-feedback-20260906","project_id":"sprite-forge-mcp","task_id":"01-feasibility"},"to":{"plan_key":"preview-feedback-20260906","project_id":"sprite-forge-mcp","task_id":"02-reviews"}},{"from":{"plan_key":"preview-feedback-20260906","project_id":"sprite-forge-mcp","task_id":"02-reviews"},"to":{"plan_key":"preview-feedback-20260906","project_id":"sprite-forge-mcp","task_id":"03-relearning"}},{"from":{"plan_key":"preview-feedback-20260906","project_id":"sprite-forge-mcp","task_id":"03-relearning"},"to":{"plan_key":"preview-feedback-20260906","project_id":"sprite-forge-mcp","task_id":"04-ui"}},{"from":{"plan_key":"preview-feedback-20260906","project_id":"sprite-forge-mcp","task_id":"04-ui"},"to":{"plan_key":"preview-feedback-20260906","project_id":"sprite-forge-mcp","task_id":"05-quality"}},{"from":{"plan_key":"preview-feedback-20260906","project_id":"sprite-forge-mcp","task_id":"05-quality"},"to":{"plan_key":"preview-feedback-20260906","project_id":"sprite-forge-mcp","task_id":"06-delivery"}}],"joins":[],"plan_digest":"a6c81be4a426b9b9eb2551f0c3ed6a11fd09cd2e8e229b9dd640c0b0660da6cd","plan_key":"preview-feedback-20260906","plan_version":"rev-220debd04beed19d42bb3c77","predecessor_plan_digest":"54037bdcb50cfee1d9d952c6c6f90475bee859700a5b6655d2e2c3c0b3e3db17","project_id":"sprite-forge-mcp","schema":"lattice.todo_plan.v6","tasks":[{"compile_binding":null,"design_memo":"既存の全画像DPO試作を再利用し、ユーザーのNG指摘と承認した修正前後から局所学習を試作する。先に既存JoyAI/SAM経路で一組を作り、画像と範囲を提示して本人の確認を得る。NGだけから修正部位を推測しない。共通マスクの範囲正規化・前後の輪郭・欠落特徴を扱う。旧LoRAを凍結基準に、同時刻同ノイズのflow目標とDiT LoRA更新をfoxで検証する。学習前、修正OKのみ、局所選好を同条件で比較し全画像を閲覧面に載せる。NG改善と保持が両立しなければ本実装に進まず原因を調べる。Grok相談は起動障害による未回収を解消して回収する。学習量と保持項は実測で決める。","lane":"F","narrative_anchor":null,"narrative_ref":"docs/archive/preview-feedback-local-source-20260906.md#L6","parent_task_id":null,"task_id":"01-feasibility","title":"指摘に基づく対応教材でAnimaの局所選好学習を実測する"},{"compile_binding":null,"design_memo":"既存の10枚生成と判定保存を活用し、画像→指摘原文→AI解釈（修正・保持・質問）→領域→候補履歴→承認→学習教材版を結ぶ最小契約を作る。NGのみや保持だけのコメントから対象を捏造せず質問する。参考画像から直し方が決まる明確な指摘には追加承認を挟まない。再修正・取消・再表示で画像との対応を維持する。REST/MCPは同じサービスを使う。focused testで元評価と候補評価、入力中の別画像、旧データの閲覧を確認する。","lane":"F","narrative_anchor":null,"narrative_ref":"docs/archive/preview-feedback-local-source-20260906.md#L7","parent_task_id":null,"task_id":"02-reviews","title":"NG箇所・保持対象と修正履歴の記録を整える"},{"compile_binding":null,"design_memo":"成立した学習契約を使い、既存JoyAI編集とSAM領域作成をComfyUIへ収める。指摘解釈→不明点解消→修正候補生成→ユーザー確認→必要なら再修正を実装する。候補OKだけで学習を始めず、明示操作で承認済みペアを固定し、転送・局所LoRA更新・新版保存・10枚の再プレビューを実行する。全NGでも修正後OKとの組で学習できる。別構図のOK画像との機械的な全組合せを廃する。画像編集だけをLoRA改善と表示しない。fixtureと公開入口からのfox実行を区別して確認する。","lane":"F","narrative_anchor":null,"narrative_ref":"docs/archive/preview-feedback-local-source-20260906.md#L8","parent_task_id":null,"task_id":"03-relearning","title":"指摘から修正候補・承認・LoRA更新を接続する"},{"compile_binding":null,"design_memo":"既存web/preview.jsを拡張する。NG欄は「どこがNGだったか？」、OK欄は「残したいところは？（任意）」。原画像・参考画像・修正候補・変更領域・修正と保持の解釈を見せる。「修正候補を作る」「この修正でOK」「まだ違う」「この修正内容でLoRAを学習する」を分ける。学習に使った元NGと承認OK、学習前後の生成結果を画像で確認できる。採用は「この学習結果を使って設定画へ」。保存再表示、再修正、狭い幅、通信失敗を実ブラウザーで確認する。","lane":"A","narrative_anchor":null,"narrative_ref":"docs/archive/preview-feedback-local-source-20260906.md#L9","parent_task_id":null,"task_id":"04-ui","title":"修正前後の確認と明示学習・新版採用の画面を作る"},{"compile_binding":null,"design_memo":"未学習seedで学習前・修正OKのみ・局所選好を比較し、修正対象と保持対象を分けて全画像を評価する。初回10枚の探索とは別の確認用seedで再現を確認する。ベルの髪型に加え別部位・別衣装・体形・人外も対象にする。入力と修正範囲、ユーザーの採否、実験評価者、母数、モデル・設定・時間・VRAM・失敗を閲覧面へ載せる。損失低下は品質成立と別。OK再現悪化があれば保持項を独立条件として比較する。改善未達を成功扱いせず方式を改訂する。","lane":"F","narrative_anchor":null,"narrative_ref":"docs/archive/preview-feedback-local-source-20260906.md#L10","parent_task_id":null,"task_id":"05-quality","title":"未知の画像で部位の改善と既存特徴の維持を確認する"},{"compile_binding":null,"design_memo":"各機能のfocused testと実ブラウザー・fox確認後に関連JavaScript試験とuv run pytestを一度通す。学習と保存の公開契約を独立反証する。既定ブランチに統合しmain-serverとfoxへ反映する。永続データを保持し、本番で指摘保存・修正候補承認・明示学習・使用教材表示・新版採用・設定画への引継ぎを確認する。今回は計画更新だけで実装・GPU実行・配備は開始しない。","lane":"F","narrative_anchor":null,"narrative_ref":"docs/archive/preview-feedback-local-source-20260906.md#L11","parent_task_id":null,"task_id":"06-delivery","title":"試験・統合・本番反映と制作工程の接続を完了する"}],"topology_digest":"7b816614388e9a11b22de2e919c191e04430e20662795bf934beab44b6d76033"},"plan_key":"preview-feedback-20260906","predecessor":{"journal_head_digest":"bd51b012c1b533be3a0d54fa4ea8256023b4095006963449c4484e436a2bcbe7","plan_digest":"54037bdcb50cfee1d9d952c6c6f90475bee859700a5b6655d2e2c3c0b3e3db17","plan_version":"v1"},"project_id":"sprite-forge-mcp","reconciliation":{"predecessor_reconciliation_digest":"fc6b26bda01db21633fef12c07b9da9764b311823cf547e91e3f43dcadeb3634","reconciliation_digest":"c4208116313f56c47c033da6f6abece6a13e0175fd49330db3d5eb7400b0cbaa","source_inventory_digest":"c43818c398de0427bb02619c38a573b8ba228c45de865a1b35b1bc10ccbb42b0"},"revision_digest":"d2c63df69ab907a034026ade23e4c2ba3a808b4664dff4ee23bbfdeed5e27a20","schema":"lattice.todo_revision.v2","source_cutover_batch":{"archive_ref":"docs/archive/preview-feedback-local-source-20260906.md","batch_digest":"a6c5ce35236cc4ceb115f6afe2ba636b53da9ec3f5e32cd844ffe98ac931c204","batch_id":"local-feedback-20260906","operations":[{"disposition":"active","live_replacement":"- 工程正本: Lattice preview-feedback-20260906 / 01-feasibility","source_digest":"11852f6902efcacb65f657b4601f5239be7991b4a2db697ad0e891a1110fb464","source_ref":".cache/sprite-local-feedback-source.md#L1","task_id":"01-feasibility"},{"disposition":"active","live_replacement":"- 工程正本: Lattice preview-feedback-20260906 / 02-reviews","source_digest":"aede63d5c893b02b1858d583a402e02ff8b7c2f6d0dc6ac50ebafa2c2acbab99","source_ref":".cache/sprite-local-feedback-source.md#L2","task_id":"02-reviews"},{"disposition":"active","live_replacement":"- 工程正本: Lattice preview-feedback-20260906 / 03-relearning","source_digest":"26c961e477702442f6537eaba514005e9914cda3a96b6cb4231cae67c52b5f63","source_ref":".cache/sprite-local-feedback-source.md#L3","task_id":"03-relearni